            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Double-sided incremental forming</rdf:li>
               <rdf:li>Springback</rdf:li>
               <rdf:li>Reverse bending</rdf:li>
               <rdf:li>Squeezing</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Novel strategies to reduce the springback for double-sided incremental forming</rdf:li>
            </rdf:Alt>
         </dc:title>
